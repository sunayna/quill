# Which LLM provider does the AI review: "gemini" (default) or "groq".
# See app.py's LLM_PROVIDER comment for why Gemini is the default.
LLM_PROVIDER=gemini

# Needed when LLM_PROVIDER=gemini — get a free key at https://aistudio.google.com/apikey
GEMINI_API_KEY=your_key_here

# Needed when LLM_PROVIDER=groq — get a free key at https://console.groq.com/keys
GROQ_API_KEY=your_key_here
